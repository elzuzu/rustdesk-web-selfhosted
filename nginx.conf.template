map_hash_bucket_size 128;   # le jeton de session fait 64 caracteres
# Freine le forcage brutal de l'authentification Basic.
# 60 par minute avec une rafale de 100 : un chargement complet du client
# (66 fichiers) passe d'un coup, une attaque retombe a une tentative par
# seconde. Mesure le 2026-09-15 : 130 requetes -> 104 passees, 26 en 429.
limit_req_zone $binary_remote_addr zone=rdauth:10m rate=60r/m;
limit_req_status 429;
# Zone SEPAREE pour l'API de la flotte : un tableau de bord qui se rafraichit ne doit pas puiser dans le seau de l'authentification.
limit_req_zone $binary_remote_addr zone=rdapi:10m rate=120r/m;

# Journal sur fichier, lu par la prison fail2ban « rustdesk-auth ». fail2ban
# tourne sur l'hote et ne sait pas lire la sortie standard d'un conteneur.
log_format rdauth '$remote_addr - $remote_user [$time_local] "$request" $status';
# Un cookie valide dispense de l'authentification Basic.
# "off" desactive auth_basic ; toute autre valeur devient le realm.
# Vraie IP du client : X-Real-IP pose par le proxy amont, sinon CF-Connecting-IP.
map $http_x_real_ip $rd_client_ip {
    ""      $http_cf_connecting_ip;
    default $http_x_real_ip;
}

map $cookie_rdsession $rd_realm {
    "__RD_SESSION_TOKEN__"  off;
    default        "RustDesk";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/wasm application/json image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 0;

    # Le proxy amont (Caddy) est la seule source fiable de l'IP client.
    # Caddy atteint nginx par la passerelle du pont Docker : sans cette ligne
    # nginx voit 172.18.0.1 pour TOUT LE MONDE et la limitation par IP mettrait
    # tous les visiteurs dans le meme seau. Mesure le 2026-09-15.
    set_real_ip_from 172.18.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header X-Real-IP;

    access_log /var/log/nginx/access.log rdauth;
    access_log /dev/stdout rdauth;

    # En-tetes de securite. ATTENTION : nginx n'herite PAS des add_header du
    # niveau « server » dans un bloc « location » qui en declare un seul. Les
    # trois blocs ci-dessous posent un cookie : sans la repetition de ces
    # lignes, la page et le bundle partaient sans aucun de ces en-tetes.
    #
    # La politique de contenu garde 'unsafe-inline' : la page est faite de blocs
    # en ligne, et le formulaire du bundle de gestionnaires onclick. Elle borne
    # le reste — aucun script, image ou connexion vers un autre hote.
    # 'wasm-unsafe-eval' : les decodeurs (zstd, opus, ogv) sont en WebAssembly.
    # connect-src data: : le bundle charge son WebAssembly embarque par fetch()
    # d'une URL data:. Sans cela le decodeur zstd ne demarre pas (presse-papier
    # et transferts de fichiers compresses). Constate par le banc navigateur.
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    # Defense en profondeur : jamais de sauvegarde ni de source servie.
    # DOIT preceder les autres regex, sinon /js/dist/index.js.orig est servi.
    location ~* \.(bak|orig)$ {
        return 404;
    }

    # Sonde de sante interne : pas d'authentification, jamais journalisee.
    location = /healthz {
        auth_basic off;
        access_log off;
        return 204;
    }

    location = /index.html {
        limit_req zone=rdauth burst=100 nodelay;
        auth_basic $rd_realm;
        auth_basic_user_file /etc/nginx/.htpasswd;
        add_header Set-Cookie "rdsession=__RD_SESSION_TOKEN__; Max-Age=7776000; Path=/; HttpOnly; Secure; SameSite=Lax";
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location ~ ^/(js/dist/|flutter_service_worker\.js|main\.dart\.js) {
        limit_req zone=rdauth burst=100 nodelay;
        auth_basic $rd_realm;
        auth_basic_user_file /etc/nginx/.htpasswd;
        add_header Set-Cookie "rdsession=__RD_SESSION_TOKEN__; Max-Age=7776000; Path=/; HttpOnly; Secure; SameSite=Lax";
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Console de session (web/js et web/css, assembles par scripts/build-web.sh).
    # « try_files … =404 » : le repli SPA de « location / » servirait la page HTML en
    # 200 pour un fichier absent, et le navigateur n'y verrait que « Unexpected token < ».
    # auth_basic, limit_req, Set-Cookie et les en-tetes de securite sont REPETES : une
    # location qui pose un add_header n'herite d'aucun de ceux du niveau superieur. « no-cache » : le nom du
    # fichier n'est pas suffixe d'un hash, il est donc revalide (304) a chaque chargement.
    location ~ ^/rd-console\.(js|css)$ {
        limit_req zone=rdauth burst=100 nodelay;
        auth_basic $rd_realm;
        auth_basic_user_file /etc/nginx/.htpasswd;
        add_header Set-Cookie "rdsession=__RD_SESSION_TOKEN__; Max-Age=7776000; Path=/; HttpOnly; Secure; SameSite=Lax";
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    # Service « flotte » (liste des postes, etat en ligne) : fleet/server.py, dans un conteneur a part et FACULTATIF.
    # - meme authentification que le reste (Basic ou cookie de session), zone de debit separee ;
    # - le nom est resolu A LA REQUETE (variable + resolver Docker) : sans cela nginx REFUSERAIT DE DEMARRER des que le
    #   conteneur « fleet » est absent ou arrete, et tout le client tomberait avec lui. Absent : 502, et la page retombe
    #   sur ses dernieres connexions ;
    # - le service verifie lui-meme X-RD et Sec-Fetch-Site (garde CSRF) ; ici on ne touche a aucun en-tete.
    location /api/ {
        limit_req zone=rdapi burst=60 nodelay;
        auth_basic $rd_realm;
        auth_basic_user_file /etc/nginx/.htpasswd;
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $rd_fleet http://fleet:8000;
        proxy_pass $rd_fleet;
        proxy_connect_timeout 2s;
        proxy_read_timeout 12s;
        client_max_body_size 16k;
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    }

    location / {
        limit_req zone=rdauth burst=100 nodelay;
        auth_basic $rd_realm;
        auth_basic_user_file /etc/nginx/.htpasswd;
        add_header Set-Cookie "rdsession=__RD_SESSION_TOKEN__; Max-Age=7776000; Path=/; HttpOnly; Secure; SameSite=Lax";
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' data: ws://$host wss://$host; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        try_files $uri $uri/ /index.html;
    }

    location /ws/id {
        proxy_pass http://__RD_BACKEND_HOST__:21118;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $rd_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /ws/relay {
        proxy_pass http://__RD_BACKEND_HOST__:21119;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $rd_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

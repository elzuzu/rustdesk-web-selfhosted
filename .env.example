# Copie de reference. En pratique, ./setup.sh genere .env pour toi.
RD_DOMAIN="rustdesk.exemple.org"       # doit pointer en A direct vers cette machine
RD_WEB_USER="admin"
RD_WEB_PASSWORD="a-remplacer"
RD_BACKEND_HOST="172.17.0.1"           # hote de hbbs/hbbr vu depuis le conteneur
RD_PUBLIC_KEY="contenu-de-data/id_ed25519.pub"
RD_DEFAULT_PEER_ID=""                  # ID preremplli dans le formulaire (facultatif)
RD_TLS_MODE="1"                        # 1 = Caddy/443, 2 = proxy inverse externe
RD_ACME_EMAIL="toi@exemple.org"
RD_SESSION_TOKEN=""                    # genere si vide ; le vider revoque les sessions

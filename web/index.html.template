<body>
<div id="app"></div>

<script>
// Chemin de rendu Flutter : inutilise ici, le client autonome dessine via
// YUVCanvas. Le stub evite que chaque trame leve une ReferenceError.
window.onRgba = function(){};

// Le navigateur cree tout AudioContext en etat "suspended" tant qu'il n'y a
// pas eu de geste utilisateur. On les recense pour les reveiller au 1er clic.
window.__audioCtxs = [];
(function(){
  var AC = window.AudioContext || window.webkitAudioContext;
  if (!AC) return;
  function Wrapped(opts){
    var c = new AC(opts);
    window.__audioCtxs.push(c);
    console.log("[audio] contexte cree (" + c.state + ", " + c.sampleRate + " Hz)");
    return c;
  }
  Wrapped.prototype = AC.prototype;
  window.AudioContext = Wrapped;
  window.webkitAudioContext = Wrapped;
  function reveiller(){
    window.__audioCtxs.forEach(function(c){
      if (c.state !== "running") c.resume().then(function(){
        console.log("[audio] contexte relance -> " + c.state);
      }).catch(function(e){ console.warn("[audio]", e); });
    });
  }
  ["click","keydown","touchstart"].forEach(function(ev){
    document.addEventListener(ev, reveiller, true);
  });
})();

// Un service worker de l'epoque Flutter reste enregistre dans les navigateurs
// qui ont visite les versions precedentes. Il reclame des fichiers supprimes
// et peut servir une version en cache de la page et du bundle, ce qui produit
// des comportements incoherents entre rechargements. On le retire.
if ("serviceWorker" in navigator) {
  navigator.serviceWorker.getRegistrations().then(function(rs){
    rs.forEach(function(r){
      r.unregister().then(function(ok){
        if (ok) console.log("[sw] service worker obsolete retire — recharge une fois");
      });
    });
  }).catch(function(){});
  if (window.caches && caches.keys) {
    caches.keys().then(function(ks){
      ks.forEach(function(k){ caches.delete(k).then(function(ok){
        if (ok) console.log("[sw] cache « " + k + " » purge"); }); });
    }).catch(function(){});
  }
}

// Diagnostic des coupures. Le Mac sonde toutes les secondes et abandonne apres
// 30 s de silence : un « Timeout » signifie donc que CE navigateur s'est tu.
// On trace ce qui peut le faire taire — gel de l'onglet, veille, perte reseau —
// et le code de fermeture du websocket, qui distingue une fermeture propre
// (1000/1001) d'une disparition brutale de la connexion (1006).
(function(){
  var dernier = Date.now();
  window.__rdVu = function(){ dernier = Date.now(); };

  function tracer(ev){
    var s = Math.round((Date.now() - dernier)/1000);
    console.warn("[diag] " + ev + " — " + s + " s depuis le dernier message recu"
               + " | onglet " + document.visibilityState);
  }
  ["freeze","resume","pagehide","pageshow"].forEach(function(e){
    document.addEventListener(e, function(){ tracer(e); }, true);
  });
  document.addEventListener("visibilitychange", function(){
    tracer("visibilite -> " + document.visibilityState);
  });
  window.addEventListener("offline", function(){ tracer("reseau perdu"); });
  window.addEventListener("online",  function(){ tracer("reseau retrouve"); });

  function showBannerError(msg, type){
    var el = document.getElementById("rderror");
    if (!el) {
      el = document.createElement("div");
      el.id = "rderror";
      el.style.cssText = "position:fixed;top:1.2rem;left:50%;transform:translateX(-50%);z-index:99999;padding:1rem 1.5rem;border-radius:8px;background:#2a1215;border:1px solid #991b1b;color:#f87171;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;font-size:0.9rem;max-width:90vw;box-shadow:0 10px 30px rgba(0,0,0,0.6);display:flex;align-items:center;gap:0.75rem;";
      document.body.appendChild(el);
    }
    var title = type === "key" ? "Échec d'authentification par clé (invalid key)" : "Échec de connexion au poste distant (Timeout)";
    el.innerHTML = '<span style="font-size:1.5rem">⚠️</span> <div><strong style="color:#fee2e2">' + title + '</strong><br><span style="font-size:0.85rem;color:#fca5a5">' + msg + '</span></div><button onclick="this.parentElement.remove()" style="background:transparent;border:0;color:#fca5a5;font-size:1.2rem;cursor:pointer;margin-left:auto;padding:0 0.4rem">✕</button>';
  }

  // Le constructeur WebSocket est enveloppe pour tracer les fermetures et la
  // progression des poignées de main WebSockets.
  var W = window.WebSocket;
  var sockets = [];
  function Trace(url, proto){
    var ws = proto === undefined ? new W(url) : new W(url, proto);
    var path = String(url).replace(/^wss?:\/\/[^/]+/, "");
    var wsStartTime = Date.now();
    console.log("[diag] websocket ouverture -> " + path);
    // Borne : une session longue enchaine les reconnexions, et chaque entree
    // retient une reference vers le WebSocket ferme.
    sockets.push({ url: url, path: path, ws: ws, created: wsStartTime });
    while (sockets.length > 10) sockets.shift();

    ws.addEventListener("open", function(){
      console.log("[diag] websocket connecte -> " + path);
    });

    var msgCount = 0;
    ws.addEventListener("message", function(e){
      dernier = Date.now();
      msgCount++;
      if (msgCount === 1) {
        console.log("[diag] premier message recu -> " + path);
      }
    });

    ws.addEventListener("close", function(e){
      var s = Math.round((Date.now() - dernier)/1000);
      var dur = Math.round((Date.now() - wsStartTime)/1000);
      console.warn("[diag] websocket ferme  code=" + e.code
                 + "  propre=" + e.wasClean
                 + "  raison=\"" + (e.reason || "") + "\""
                 + "  silence=" + s + " s"
                 + "  onglet=" + document.visibilityState
                 + "  " + path);

      // hbbr ne repond jamais au client sur ces deux echecs : il se contente de
      // fermer. Seule la duree de vie de la liaison les distingue, et elle
      // suffit, car les deux chemins sont explicites dans relay_server.rs :
      //   licence_key invalide  -> « return » immediat, fermeture en < 1 s
      //   pair jamais arrive    -> sleep(30) puis retrait, fermeture vers 30 s
      // On se base sur la duree de vie de CETTE liaison, pas sur le silence
      // global : « dernier » est partage entre toutes les liaisons ouvertes.
      if (path.indexOf("/ws/relay") !== -1 && window.RD && !window.RD.ready) {
        if (dur <= 5) {
          showBannerError("hbbr a refusé la clé publique. La valeur envoyée par cette page "
            + "doit être exactement celle de data/id_ed25519.pub côté serveur : "
            + "docker exec hbbs cat /root/id_ed25519.pub — cause la plus fréquente, "
            + "hbbs et hbbr ne partagent pas le même volume data/, et chacun a donc "
            + "généré sa propre paire de clés.", "key");
        } else if (dur >= 20) {
          showBannerError("Le poste distant n'a pas rejoint le relais dans les 30 s. "
            + "Vérifie qu'il est en ligne, qu'il pointe vers ce serveur et que le "
            + "port 21117/tcp est ouvert.", "timeout");
        }
      }
    });
    return ws;
  }
  Trace.prototype = W.prototype;
  ["CONNECTING","OPEN","CLOSING","CLOSED"].forEach(function(k,i){ Trace[k] = i; });
  window.WebSocket = Trace;

  window.rdDiag = function(){
    console.group("=== DIAGNOSTIC RUSTDESK WEB ===");
    console.log("Hôte configuré :", localStorage.getItem("custom-rendezvous-server") || "(non défini)");
    var k = localStorage.getItem("key") || "";
    console.log("Clé publique :", k ? (k.substring(0, 12) + "..." + k.substring(k.length - 6) + " (longueur " + k.length + ")") : "(vide)");
    console.log("ID cible :", localStorage.getItem("id") || "(vide)");
    console.log("Codecs retenus :", window.RD ? window.RD.codec : "non initialisé");
    if (window.RD){
      var S = window.RD.stats, dt = (Date.now() - (S.movesT0 || Date.now())) / 1000;
      console.log("Souris — evenements coalesces :", window.RD.coalesce ? "actives" : "desactives",
                  "| messages envoyes :", S.moves,
                  dt > 1 ? "(" + (S.moves / dt).toFixed(1) + "/s)" : "");
    }
    console.log("Sockets récents :", sockets.map(function(s){
      var st = ["CONNECTING","OPEN","CLOSING","CLOSED"][s.ws.readyState] || s.ws.readyState;
      return s.path + " [" + st + "] ouvert depuis " + Math.round((Date.now() - s.created)/1000) + " s";
    }));
    console.groupEnd();
  };

  // Retire : un module dit « TimeWarp » appliquait ici un translate3d de +/-10 px
  // sur #canvas pendant les glissements. #canvas est le CONTENEUR, et pos() derive
  // les coordonnees de getBoundingClientRect(), qui inclut les transformations CSS :
  // le pointeur distant partait donc decale d'autant, precisement pendant les
  // gestes ou la precision compte. Aucune reprojection n'etait faite non plus,
  // l'image etait seulement secouee puis remise a zero au bout de 35 ms.
})();

// Etat partage entre les deux blocs de script.
window.RD = {
  ready:false,        // vrai apres peer_info : rien ne doit partir avant
  res:[],             // modes supportes par l'ecran distant
  orig:null,          // resolution d'origine
  codec:null,         // "h265" | "vp9" | null (= logiciel ogv)
  forced:"auto",      // choix utilisateur dans la barre
  dec:null,           // VideoDecoder unique, reutilise entre connexions
  wantKey:true,       // garde image-cle : jeter les deltas avant la 1ere cle
  errors:0,           // echecs consecutifs avant repli
  lastPurge:0,        // horodatage de la derniere purge de file de decodage
  sawAnnexB:false,
  W:0, H:0,           // dimensions de l'ecran distant
  cursors:{},         // cache des curseurs distants, par id
  cursorN:0,
  // Evenements pointeur coalesces : plus fideles, mais ils multiplient le debit
  // sortant. Desactives par defaut, cf. rdCoalesce().
  coalesce: (function(){ try{ return localStorage.getItem("rd-coalesce") === "1"; }catch(e){ return false; } })(),
  // Une latence se lit en distribution, pas en moyenne : c'est la queue qui
  // rend une session desagreable. On garde des fenetres glissantes.
  stats:{ delay:[], decode:[], bitrate:0, frames:0, pend:[], moves:0, movesT0:0 }
};

// Bascule les evenements pointeur coalesces et rend la comparaison mesurable :
// rdCoalesce(false) puis un glissement, rdDiag(), rdCoalesce(true), on refait.
window.rdCoalesce = function(on){
  window.RD.coalesce = !!on;
  try{ localStorage.setItem("rd-coalesce", on ? "1" : "0"); }catch(e){}
  window.RD.stats.moves = 0; window.RD.stats.movesT0 = Date.now();
  console.log("[souris] evenements coalesces " + (on ? "actives" : "desactives")
            + " — compteur remis a zero");
  return window.RD.coalesce;
};

// hbbs journalise l'objet TestDelay brut ; c'est la seule source de last_delay
// accessible depuis la page, le traitement etant enferme dans le bundle.
(function(){
  var orig = console.log;
  console.log = function(){
    try{
      var a = arguments[0];
      if (a && typeof a === "object" && typeof a.last_delay === "number"){
        var S = window.RD.stats;
        S.delay.push(a.last_delay);
        if (S.delay.length > 300) S.delay.shift();
        if (typeof a.target_bitrate === "number") S.bitrate = a.target_bitrate;
        return;                       // absorbe : ces lignes noyaient la console
      }
    }catch(_){}
    return orig.apply(console, arguments);
  };
})();

window.__rdPct = function(arr, p){
  if (!arr.length) return null;
  var s = arr.slice().sort(function(x,y){ return x-y; });
  return s[Math.min(s.length-1, Math.floor(s.length*p))];
};

// Le curseur distant est transmis (cursor_data / cursor_id) mais le code qui
// devait le dessiner est commente dans connection.ts. On le reimplemente :
// bitmap RGBA -> canvas -> data URL -> propriete CSS cursor avec son point
// chaud. Sans ca, on garde le pointeur local, qui ne reflete jamais l'etat
// de macOS (redimensionnement, texte, main, attente...).
window.__rdApplyCursor = function(css){
  ["player","rdcanvas"].forEach(function(id){
    var el = document.getElementById(id);
    if (el) el.style.cursor = css;
  });
};
window.__rdCursorFromData = function(cd, val){
  try{
    var w = parseInt(val(cd.width),10), h = parseInt(val(cd.height),10);
    var hx = parseInt(val(cd.hotx),10)||0, hy = parseInt(val(cd.hoty),10)||0;
    if (!(w>0 && h>0) || w>128 || h>128) return null;   // limite navigateur
    var raw = cd.colors;
    var arr = typeof raw === "string" ? JSON.parse(raw) : raw;
    if (!arr || arr.length < w*h*4) return null;
    var cv = document.createElement("canvas");
    cv.width = w; cv.height = h;
    var ctx = cv.getContext("2d");
    ctx.putImageData(new ImageData(new Uint8ClampedArray(arr), w, h), 0, 0);
    return "url(" + cv.toDataURL() + ") " + hx + " " + hy + ", auto";
  }catch(e){ console.warn("[curseur]", e); return null; }
};

window.onGlobalEvent = function(payload){
  var e;
  try { e = JSON.parse(payload); } catch(_) { return; }

  // jsonfyForDart serialise CHAQUE valeur : il faut les reparser une a une.
  function val(x){ if (typeof x !== "string") return x;
                   try { return JSON.parse(x); } catch(_) { return x; } }

  try {
    if (e.name === "peer_info") {
      var r = val(e.resolutions);
      if (r && r.resolutions) window.RD.res = r.resolutions;
      var d = val(e.displays);
      if (d && d.length) {
        var cur = parseInt(val(e.current_display) || 0, 10) || 0;
        if (d[cur]) {
          if (d[cur].original_resolution) window.RD.orig = d[cur].original_resolution;
          window.RD.W = d[cur].width|0; window.RD.H = d[cur].height|0;
        }
      }
      window.RD.ready = true;
      console.log("[session] prete — " + window.RD.res.length + " resolutions disponibles");
      if (window.__rdMenu) window.__rdMenu();
      if (window.__rdNegotiate) window.__rdNegotiate();
    }
    if (e.name === "switch_display") {
      var r2 = val(e.resolutions);
      if (r2 && r2.resolutions) { window.RD.res = r2.resolutions;
        if (window.__rdMenu) window.__rdMenu(); }
      var w = parseInt(val(e.width) || 0, 10), h = parseInt(val(e.height) || 0, 10);
      if (w > 0 && h > 0) {
        window.RD.W = w; window.RD.H = h;
        // Redimensionner le canvas ACTIF, pas #player en dur.
        var c = window.__rdActive ? window.__rdActive() : document.getElementById("player");
        if (c) { c.width = w; c.height = h; console.log("[ecran] " + w + "x" + h); }
        if (window.__rdFit) window.__rdFit();
      }
      // Nouveau flux : reinitialiser le decodeur et redemander une image-cle.
      if (window.__rdResetDecoder) window.__rdResetDecoder();
    }
    if (e.name === "cursor_data") {
      var cid = String(val(e.id));
      var css = window.__rdCursorFromData(e, val);
      if (css) {
        // Cache borne : les curseurs systeme sont peu nombreux et recurrents.
        if (window.RD.cursorN > 64) { window.RD.cursors = {}; window.RD.cursorN = 0; }
        if (!window.RD.cursors[cid]) window.RD.cursorN++;
        window.RD.cursors[cid] = css;
        window.__rdApplyCursor(css);
      }
    }
    if (e.name === "cursor_id") {
      var known = window.RD.cursors[String(val(e.id))];
      window.__rdApplyCursor(known || "default");
    }
  } catch(err) { console.warn("[onGlobalEvent]", err); }
};
</script>

<script src="ogvjs-1.8.6/ogv.js"></script>
<script src="yuv-canvas-1.2.6.js"></script>
<script type="module" crossorigin src="js/dist/index.js"></script>

<script>
// Couche d'entree et chemin video WebCodecs.
// ui.js ne cable que l'affichage : souris, clavier et codec sont ajoutes ici,
// par substitution de methodes sur window.curConn. Aucun patch du bundle.
(function(){
  var RD = window.RD;

  // ---------------------------------------------------------------- entrees
  var CTRL={Enter:"Return",Backspace:"Backspace",Escape:"Escape",Tab:"Tab",
    ArrowLeft:"LeftArrow",ArrowRight:"RightArrow",ArrowUp:"UpArrow",ArrowDown:"DownArrow",
    Home:"Home",End:"End",Delete:"Delete",Insert:"Insert",PageUp:"PageUp",
    PageDown:"PageDown"," ":"Space",CapsLock:"CapsLock",
    Alt:"Alt",AltGraph:"Alt",Control:"Control",Shift:"Shift",Meta:"Meta"};
  for(var i=1;i<=12;i++) CTRL["F"+i]="F"+i;
  var MODK={Shift:1,Control:1,Alt:1,AltGraph:1,Meta:1};

  function send(n,v){ try{ window.setByName(n, JSON.stringify(v)); }catch(e){ console.warn("[entree]",e); } }
  function mods(e){ return {alt:String(e.altKey),ctrl:String(e.ctrlKey),
                            shift:String(e.shiftKey),command:String(e.metaKey)}; }

  // RustDesk transmet les modificateurs UN POUR UN : Ctrl+C arrive en Control+C
  // sur le Mac, ou copier est Cmd+C. Seul le Terminal y reagit, parce que
  // Control+C y est le vrai raccourci (SIGINT) — d'ou l'impression trompeuse
  // que "ca marche par endroits". On permute donc ici, cote navigateur.
  // Desactivable : dans un terminal distant, Control doit rester Control.
  var swapCtrlCmd = localStorage.getItem("rd-swap-ctrl") !== "0";
  function applySwap(m){
    // N'inverse que si exactement l'un des deux est enfonce : Ctrl+Cmd+X
    // reste tel quel, et une combinaison sans ni l'un ni l'autre est intacte.
    if (swapCtrlCmd && (m.ctrl === "true") !== (m.command === "true")){
      var t = m.ctrl; m.ctrl = m.command; m.command = t;
    }
    return m;
  }
  function merge(a,b){ for(var k in b) a[k]=b[k]; return a; }
  function pos(c,e){ var r=c.getBoundingClientRect();
    return {x:Math.round((e.clientX-r.left)*(c.width/r.width)),
            y:Math.round((e.clientY-r.top)*(c.height/r.height))}; }
  function btn(e){ return e.button===2?"right":e.button===1?"wheel":"left"; }

  // Envoi direct d'un message protobuf via la connexion courante.
  // curConn est expose globalement et ses proprietes survivent a la
  // minification, donc aucun patch du bundle n'est necessaire.
  function rdSend(msg){
    try{
      if(!RD.ready) return false;                     // jamais avant peer_info :
      var c=window.curConn;                           // les compteurs secretbox
      if(!c||!c._ws||!c._ws._websocket) return false; // seraient desynchronises
      if(c._ws._websocket.readyState!==1) return false;
      c._ws.sendMessage(msg);
      return true;
    }catch(e){ console.warn("[envoi]",e); return false; }
  }
  window.__rdSend = rdSend;

  // ------------------------------------------------------------- canvas
  function player(){ return document.getElementById("player"); }
  function rdcanvas(){
    var c = document.getElementById("rdcanvas");
    if (c) return c;
    var p = player(); if (!p) return null;
    c = document.createElement("canvas");
    c.id = "rdcanvas";
    p.parentNode.insertBefore(c, p.nextSibling);
    return c;
  }
  // Le canvas reellement affiche depend du chemin de decodage actif.
  function active(){ return RD.codec ? rdcanvas() : player(); }
  window.__rdActive = active;

  function showActive(){
    var p = player(), r = document.getElementById("rdcanvas");
    if (!p) return;
    if (RD.codec && r){ p.style.display="none"; r.style.display="block"; }
    else { p.style.display="block"; if(r) r.style.display="none"; }
  }

  // Taille d'affichage calculee a la main : conserver le ratio exact evite
  // les bandes noires DANS l'element, qui fausseraient les coordonnees souris.
  function fitCanvas(){
    var c = active(); if(!c || !c.width || !c.height) return;
    var k = Math.min(window.innerWidth/c.width, window.innerHeight/c.height);
    c.style.width  = Math.floor(c.width*k)+"px";
    c.style.height = Math.floor(c.height*k)+"px";
  }
  window.__rdFit = fitCanvas;

  // --------------------------------------------------------- sonde codec
  var CODECS = {
    // Niveaux volontairement hauts : L123 (4.1) et vp09 level 1.0 sont
    // insuffisants pour un ecran Retina, et certains navigateurs refusent.
    h265: "hev1.1.6.L153.b0",
    vp9:  "vp09.00.50.08"
  };
  async function probeCodecs(){
    if (typeof VideoDecoder === "undefined"){
      console.log("[codec] WebCodecs indisponible — decodage logiciel");
      return null;
    }
    var w = RD.W || 1920, h = RD.H || 1080;
    for (var name of ["h265","vp9"]){
      try{
        var s = await VideoDecoder.isConfigSupported({
          codec: CODECS[name], codedWidth: w, codedHeight: h,
          hardwareAcceleration: "prefer-hardware", optimizeForLatency: true });
        if (s && s.supported){ console.log("[codec] "+name+" accepte ("+CODECS[name]+")"); return name; }
        console.log("[codec] "+name+" refuse");
      }catch(e){ console.log("[codec] "+name+" refuse ("+e.name+")"); }
    }
    return null;
  }

  // ------------------------------------------------------ decodeur unique
  // Un seul VideoDecoder pour toute la vie de la page : conn.close() ne ferme
  // que le decodeur ogv, le notre fuirait a chaque reconnexion.
  function ensureDecoder(){
    if (RD.dec && RD.dec.state !== "closed") return RD.dec;
    var ctx = null, pendingFrame = null, rafId = null;

    function drawPendingFrame(){
      rafId = null;
      if (!pendingFrame) return;
      var frame = pendingFrame; pendingFrame = null;
      try {
        var c = rdcanvas();
        if (c.width !== frame.displayWidth || c.height !== frame.displayHeight){
          c.width = frame.displayWidth; c.height = frame.displayHeight;
          ctx = null; fitCanvas();
        }
        if (!ctx) {
          ctx = c.getContext("2d", {alpha:false, desynchronized:true});
          if (ctx) ctx.imageSmoothingEnabled = false;
        }
        ctx.drawImage(frame, 0, 0);
        RD.errors = 0;
        var S = RD.stats, t0 = S.pend.shift();
        if (t0 !== undefined){
          S.decode.push(performance.now() - t0);
          if (S.decode.length > 300) S.decode.shift();
        }
        S.frames++;
      } catch(e){ console.warn("[webcodecs] rendu", e); }
      finally { frame.close(); }
    }

    RD.dec = new VideoDecoder({
      output: function(frame){
        // Le decodeur sort les trames au rythme du reseau, l'ecran ne les
        // affiche qu'au rafraichissement : dessiner hors de ce rythme fait du
        // travail invisible. On ne garde donc que la derniere trame arrivee et
        // on la dessine dans le rAF suivant. Une trame remplacee avant d'etre
        // affichee est fermee sur-le-champ, sinon le pool GPU se vide.
        if (pendingFrame) { pendingFrame.close(); }
        pendingFrame = frame;
        if (!rafId) { rafId = requestAnimationFrame(drawPendingFrame); }
      },
      error: function(e){
        console.warn("[webcodecs] erreur", e.message||e);
        if (++RD.errors >= 3) fallbackToSoftware("erreurs de decodage repetees");
      }
    });
    RD.dec.configure({ codec: CODECS[RD.codec], codedWidth: RD.W||1920,
                       codedHeight: RD.H||1080, hardwareAcceleration:"prefer-hardware",
                       optimizeForLatency: true });
    RD.wantKey = true;
    console.log("[webcodecs] configure en "+RD.codec);
    return RD.dec;
  }
  function resetDecoder(){
    if (!RD.dec || RD.dec.state === "closed") return;
    try{ RD.dec.reset();
         RD.dec.configure({ codec: CODECS[RD.codec], codedWidth: RD.W||1920,
                            codedHeight: RD.H||1080, hardwareAcceleration:"prefer-hardware",
                            optimizeForLatency: true });
    }catch(e){ console.warn("[webcodecs] reset", e); }
    RD.wantKey = true;
    try{ window.curConn && window.curConn.refresh(); }catch(_){}
  }
  window.__rdResetDecoder = function(){ if (RD.codec) resetDecoder(); };

  // ---------------------------------------------------- negociation codec
  function negotiate(){
    if (!RD.ready) return false;
    var ab = RD.codec === "h265" ? {ability_h265:1, ability_vp9:1, prefer:3}
           : RD.codec === "vp9"  ? {ability_h265:0, ability_vp9:1, prefer:1}
           :                       {ability_h265:0, ability_vp9:1, prefer:1};
    var ok = rdSend({misc:{option:{supported_decoding:ab}}});
    if (ok){
      console.log("[codec] declare : "+(RD.codec||"logiciel")+" (prefer="+ab.prefer+")");
      try{ window.curConn.refresh(); }catch(_){}   // force une image-cle
    }
    return ok;
  }
  window.__rdNegotiate = function(){
    if (RD.forced === "logiciel"){ RD.codec = null; showActive(); negotiate(); return; }
    if (RD.forced === "h265" || RD.forced === "vp9"){ RD.codec = RD.forced; }
    if (RD.codec) { ensureDecoder(); }
    showActive(); fitCanvas(); negotiate();
  };

  // Repli : renegocier AVANT de restaurer, sinon le serveur continue d'emettre
  // du H265 que la methode d'origine ne sait ni decoder ni acquitter -> freeze.
  function fallbackToSoftware(raison){
    if (!RD.codec) return;
    console.warn("[codec] repli logiciel : "+raison);
    RD.codec = null; RD.errors = 0;
    negotiate();
    var c = window.curConn;
    if (c && c.__rdOrigHandle){ c.handleVideoFrame = c.__rdOrigHandle; }
    if (c && c.__rdOrigDraw){ c.draw = c.__rdOrigDraw; }
    showActive(); fitCanvas();
  }

  // ------------------------------------------- substitution sur curConn
  function patchConn(c){
    if (!c || !c._ws) return;
    if (c.__rdPatchedWs === c._ws) return;    // reconnect() reutilise l'instance
    c.__rdPatchedWs = c._ws;

    if (!c.__rdOrigHandle) c.__rdOrigHandle = c.handleVideoFrame;
    if (!c.__rdOrigDraw)   c.__rdOrigDraw   = c.draw;

    c.handleVideoFrame = function(vf){
      // Ce msgbox est ce qui rend div#canvas visible (ui.js, branche !type).
      // L'omettre laisse la page bloquee sur "Connecting" — ecran noir.
      if (!this._firstFrame){ this.msgbox("", "", ""); this._firstFrame = true; }

      var evfs = RD.codec === "h265" ? vf.h265s
               : RD.codec === "vp9"  ? vf.vp9s
               : null;

      if (!RD.codec || !evfs){
        return this.__rdOrigHandle.call(this, vf);   // chemin ogv d'origine
      }

      var dec;
      try { dec = ensureDecoder(); }
      catch(e){ console.warn("[webcodecs] init", e); this.sendVideoReceived();
                fallbackToSoftware("configuration impossible"); return; }

      // Purge anti-retard : si la file du decodeur s'accumule, tout ce qui y
      // reste est deja perime — mieux vaut la vider et repartir d'une image-cle.
      //
      // Chaque purge coute une image-cle complete reemise par le poste distant.
      // Sans garde-fou, un simple hoquet en declenche une, dont le surcout de
      // debit en provoque une autre : la boucle s'entretient. D'ou un seuil plus
      // haut qu'une simple trame de retard, et un intervalle minimal entre deux
      // purges.
      var qMax = 6, purgeMinMs = 3000;
      if (dec && dec.decodeQueueSize > qMax
              && Date.now() - (RD.lastPurge || 0) > purgeMinMs) {
        RD.lastPurge = Date.now();
        console.warn("[webcodecs] file de decodage encombree ("
                   + dec.decodeQueueSize + " trames), purge et image-cle");
        try {
          dec.reset();
          dec.configure({ codec: CODECS[RD.codec], codedWidth: RD.W||1920, codedHeight: RD.H||1080, hardwareAcceleration:"prefer-hardware", optimizeForLatency: true });
          RD.wantKey = true;
          // reset() abandonne les trames en vol : leurs horodatages resteraient
          // dans la file de mesure et fausseraient durablement les percentiles.
          RD.stats.pend.length = 0;
          this.refresh();
        } catch(_){}
      }

      var frames = evfs.frames || [];
      for (var i=0; i<frames.length; i++){
        var f = frames[i];
        if (RD.wantKey){
          if (!f.key) continue;                       // garde image-cle
          RD.wantKey = false;
          if (!RD.sawAnnexB){
            RD.sawAnnexB = true;
            console.log("[flux] premiers octets de la cle : " +
              Array.from(f.data.slice(0,5)).map(function(b){
                return b.toString(16).padStart(2,"0"); }).join(" "));
          }
        }
        try{
          RD.stats.pend.push(performance.now());
          if (RD.stats.pend.length > 60) RD.stats.pend.shift();
          dec.decode(new EncodedVideoChunk({
            type: f.key ? "key" : "delta",
            timestamp: Number(f.pts||0) * 1000,
            data: f.data }));
        }catch(e){
          RD.stats.pend.pop();
          console.warn("[webcodecs] decode", e.name);
          RD.wantKey = true;
          if (++RD.errors >= 3) fallbackToSoftware("decode a echoue 3 fois");
          break;
        }
      }
      // ACK inconditionnel, une fois par VideoFrame recu, y compris pour les
      // lots jetes : video_ack_required=true, un ACK manquant fige le flux.
      this.sendVideoReceived();
    };

    // Supprime le SECOND globals.draw (un drawFrame + un readPixels+flip de
    // 8,3 Mo en moins par trame). Le rendu visible reste dans _draw, dont la
    // closure appartient au bundle. Sans effet aux niveaux 1 et 2, ou draw()
    // n'est plus appele du tout.
    c.draw = function(f){ if (this._draw) this._draw(f); };

    console.log("[patch] connexion instrumentee");
  }

  // ---------------------------------------------------- cablage par canvas
  function wireCanvas(c){
    if(!c || c.dataset.wired) return; c.dataset.wired="1";
    // Pas de curseur impose : c'est le curseur distant, recu par cursor_data,
    // qui doit s'afficher pour refleter l'etat de macOS.
    c.tabIndex=0; c.style.outline="none";
    c.oncontextmenu=function(e){ e.preventDefault(); };

    // Une souris a haute frequence produit plusieurs positions par trame ; le
    // navigateur les regroupe et getCoalescedEvents() les restitue toutes. Plus
    // fidele, mais chaque position devient un message sortant de plus vers le
    // relais. Le gain n'etant pas acquis sur une liaison distante, c'est un choix
    // explicite et mesurable, pas un defaut. Voir rdCoalesce() et rdDiag().
    c.addEventListener("mousemove", function(e){
      var evs = (RD.coalesce && typeof e.getCoalescedEvents === "function")
              ? e.getCoalescedEvents() : [e];
      if (!RD.stats.movesT0) RD.stats.movesT0 = Date.now();
      for (var i = 0; i < evs.length; i++){
        var p = pos(c, evs[i]);
        send("send_mouse", merge({type:"", buttons:"", x:p.x, y:p.y}, mods(evs[i])));
        RD.stats.moves++;
      }
    });
    c.addEventListener("mousedown",function(e){ e.preventDefault(); c.focus(); var p=pos(c,e);
      send("send_mouse",merge({type:"down",buttons:btn(e),x:p.x,y:p.y},mods(e))); });
    c.addEventListener("mouseup",function(e){ e.preventDefault(); var p=pos(c,e);
      send("send_mouse",merge({type:"up",buttons:btn(e),x:p.x,y:p.y},mods(e))); });
    c.addEventListener("wheel",function(e){ e.preventDefault();
      send("send_mouse",merge({type:"wheel",buttons:"",
        x:e.deltaX>0?-1:e.deltaX<0?1:0, y:e.deltaY>0?-1:e.deltaY<0?1:0},mods(e)));
    },{passive:false});

    function key(e,down){
      var k=e.key;
      if(MODK[k]){ e.preventDefault(); return; }
      var name=CTRL[k];
      if(name){
        e.preventDefault();
        send("input_key",merge({name:name,down:String(down),press:"false"},applySwap(mods(e))));
        return;
      }
      if(k.length!==1) return;
      // Ctrl/Cmd+V : NE PAS intercepter, sinon le navigateur n'emet pas "paste".
      if((e.ctrlKey||e.metaKey)&&!e.altKey&&k.toLowerCase()==="v") return;
      if(e.ctrlKey||e.altKey||e.metaKey){
        e.preventDefault();
        var base=(k>="A"&&k<="Z")?k.toLowerCase():k;
        send("input_key",merge({name:base,down:String(down),press:"false"},applySwap(mods(e))));
        return;
      }
      // Texte simple : le navigateur a deja resolu la disposition (la disposition locale,
      // accents, majuscules). On envoie le caractere final tel quel.
      e.preventDefault();
      if(down){ try{ window.setByName("input_string",k); }catch(x){ console.warn("[entree]",x); } }
    }
    c.addEventListener("keydown",function(e){ key(e,true); });
    c.addEventListener("keyup",function(e){ key(e,false); });
    c.focus();
  }



  // ------------------------------------------------------ reprise auto
  // Une coupure reseau, un relais recree ou un onglet endormi terminent la
  // session. Plutot que de retomber sur le formulaire, on retente, avec un
  // delai croissant pour ne pas marteler un serveur qui redemarre.
  var reprise = { n:0, timer:null, voulue:false };

  function repriseAnnuler(){
    if (reprise.timer){ clearTimeout(reprise.timer); reprise.timer = null; }
    reprise.n = 0;
  }

  function repriseInfo(txt){
    var h = window.__rdHud;
    if (h) h.dataset.reprise = txt || "";
  }

  function repriseplanifier(){
    if (reprise.voulue){ console.log("[reprise] deconnexion demandee, pas de reprise"); return; }
    if (reprise.timer) return;
    if (reprise.n >= 6){
      console.warn("[reprise] abandon apres 6 tentatives");
      repriseInfo("reprise abandonnee — recharge la page");
      return;
    }
    var delai = Math.min(30000, 1000 * Math.pow(2, reprise.n));
    reprise.n++;
    console.log("[reprise] tentative " + reprise.n + "/6 dans " + (delai/1000) + " s");
    repriseInfo("reconnexion " + reprise.n + "/6 dans " + (delai/1000) + " s");
    reprise.timer = setTimeout(function(){
      reprise.timer = null;
      repriseInfo("reconnexion en cours…");
      try { if (window.connect) window.connect(); }
      catch(e){ console.warn("[reprise]", e); }
    }, delai);
  }

  // --------------------------------------------------- verrou de veille
  // Empeche l'ecran de se verrouiller pendant une session, comme le font
  // YouTube en lecture et le client RustDesk natif. Le navigateur libere
  // le verrou des que l'onglet passe en arriere-plan : il faut le reprendre
  // au retour, sinon l'ecran s'eteint apres un aller-retour vers un autre onglet.
  var veille = null, veillePrevenu = false;

  async function veilleActiver(){
    if (veille) return;
    if (!("wakeLock" in navigator)){
      if (!veillePrevenu){
        veillePrevenu = true;
        console.warn("[veille] API Screen Wake Lock indisponible dans ce navigateur — "
                   + "l'ecran pourra se verrouiller pendant la session");
      }
      return;
    }
    try{
      veille = await navigator.wakeLock.request("screen");
      veille.addEventListener("release", function(){ veille = null; });
      console.log("[veille] verrou acquis — l'ecran ne se verrouillera pas");
    }catch(e){
      // Refus typique : document non visible, ou politique d'economie d'energie.
      console.warn("[veille] refus :", e.name, e.message);
      veille = null;
    }
  }

  async function veilleLiberer(){
    if (!veille) return;
    var v = veille; veille = null;
    try{ await v.release(); console.log("[veille] verrou libere"); }catch(_){}
  }

  document.addEventListener("visibilitychange", function(){
    if (document.visibilityState !== "visible"){ veille = null; return; }
    var c = active();
    if (c && c.width > 300) veilleActiver();
  });

  // ------------------------------------------------- cablage global, 1 fois
  var globalWired = false;
  function wireGlobal(){
    if (globalWired) return; globalWired = true;

    // --- Presse-papier sortant : navigateur -> Mac ---
    document.addEventListener("paste", function(ev){
      var a = document.activeElement;
      if (a !== player() && a !== document.getElementById("rdcanvas")) return;
      ev.preventDefault();
      // Un fichier copie dans le Finder arrive ici sous forme de File : le
      // presse-papier n'en porte qu'une POIGNEE, les octets n'etant lus qu'a
      // l'appel de arrayBuffer(). C'est le sens navigateur -> Mac, le seul que
      // le web autorise ; l'inverse est impossible, aucune API ne permet
      // d'ecrire un fichier dans le presse-papier du systeme.
      var cd = ev.clipboardData || window.clipboardData;
      if (cd && cd.files && cd.files.length && window.RDFT){
        console.log("[presse-papier] "+cd.files.length+" fichier(s) — televersement");
        window.RDFT.accepterDepot(cd);
        return;
      }
      var t="";
      try{ t=cd ? (cd.getData("text/plain")||"") : ""; }catch(_){}
      if(!t){ console.log("[presse-papier] ignore (contenu non textuel)"); return; }
      if(t.length>1048576){ console.warn("[presse-papier] trop volumineux, ignore"); return; }
      var bytes=new TextEncoder().encode(t);
      if(rdSend({clipboard:{content:bytes,compress:false}})){
        console.log("[presse-papier] "+bytes.length+" octets envoyes");
        setTimeout(function(){
          // Rejouer la frappe de collage sur le bon modificateur : Cmd+V si
          // la permutation est active, Ctrl+V sinon (terminal distant).
          var m={alt:"false",shift:"false",
                 ctrl: swapCtrlCmd ? "false" : "true",
                 command: swapCtrlCmd ? "true" : "false"};
          send("input_key",merge({name:"v",down:"true",press:"false"},m));
          send("input_key",merge({name:"v",down:"false",press:"false"},m));
        },150);
      }
    });

    // --- Barre flottante ---
    var bar=document.createElement("div"); bar.id="rdbar";
    var sel=document.createElement("select"); sel.title="Resolution de l'ecran distant";
    var fit=document.createElement("button"); fit.textContent="Ajuster";
    fit.title="Choisir la resolution la plus proche de la fenetre";
    var qual=document.createElement("select"); qual.title="Qualite d'image";
    [["balanced","Equilibre"],["best","Qualite"],["low","Fluidite"]].forEach(function(o){
      var x=document.createElement("option"); x.value=o[0]; x.textContent=o[1]; qual.appendChild(x); });
    qual.onchange=function(){
      try{ window.setByName("image_quality",qual.value); console.log("[qualite] "+qual.value); }
      catch(e){ console.warn(e); }
      var c=active(); if(c) c.focus();
    };
    // custom_fps est un PLAFOND, pas une cible : le serveur calcule la cadence
    // reelle depuis la latence mesuree (ABR), puis la rabote a cette valeur.
    // Monter le plafond au-dessus de ce que l'ABR accorde ne change donc rien ;
    // le baisser, si.
    var fps=document.createElement("select");
    fps.title="Plafond de cadence. Le serveur decide la cadence reelle selon "
            + "la latence ; ce reglage ne fait que la borner. Le baisser a un "
            + "effet immediat, le monter n'en a que si la liaison suit.";
    [[30,"30 i/s max"],[60,"60 i/s max"],[15,"15 i/s max"],[10,"10 i/s max"]]
      .forEach(function(o){ var x=document.createElement("option");
        x.value=o[0]; x.textContent=o[1]; fps.appendChild(x); });
    fps.onchange=function(){
      if(rdSend({misc:{option:{custom_fps:+fps.value}}}))
        console.log("[cadence] plafond a "+fps.value+" i/s (cadence reelle decidee par l'ABR)");
      var c=active(); if(c) c.focus();
    };
    var cod=document.createElement("select"); cod.title="Codec video";
    [["auto","Codec auto"],["h265","H265"],["vp9","VP9"],["logiciel","Logiciel"]]
      .forEach(function(o){ var x=document.createElement("option");
        x.value=o[0]; x.textContent=o[1]; cod.appendChild(x); });
    cod.onchange=function(){
      RD.forced = cod.value;
      if (RD.forced === "auto"){ probeCodecs().then(function(c){ RD.codec=c; window.__rdNegotiate(); }); }
      else { window.__rdNegotiate(); }
      var c=active(); if(c) c.focus();
    };
    // Permutation Ctrl/Cmd : indispensable hors terminal, nuisible dedans.
    var swp=document.createElement("button");
    function majSwap(){
      swp.textContent = swapCtrlCmd ? "Ctrl→Cmd" : "Ctrl brut";
      swp.title = swapCtrlCmd
        ? "Ctrl est converti en Cmd (copier/coller macOS). Cliquer pour le mode terminal."
        : "Ctrl est transmis tel quel (Ctrl+C = SIGINT). Cliquer pour le mode macOS.";
      swp.style.background = swapCtrlCmd ? "#1f4d3a" : "#2a2f38";
    }
    swp.onclick=function(){
      swapCtrlCmd = !swapCtrlCmd;
      localStorage.setItem("rd-swap-ctrl", swapCtrlCmd ? "1" : "0");
      majSwap();
      console.log("[clavier] "+(swapCtrlCmd?"Ctrl converti en Cmd":"Ctrl transmis tel quel"));
      var c=active(); if(c) c.focus();
    };
    majSwap();

    var quit=document.createElement("button"); quit.textContent="Quitter"; quit.className="quit";
    [sel,fit,qual,fps,cod,swp,quit].forEach(function(x){ bar.appendChild(x); });
    document.body.appendChild(bar);

    var orig=document.querySelector("#canvas > button");
    if(orig) orig.style.display="none";
    quit.onclick=function(){
      reprise.voulue = true; repriseAnnuler(); repriseInfo("");
      if(orig) orig.click(); else if(window.cancel) window.cancel();
    };

    function apply(w,h){
      if(rdSend({misc:{change_resolution:{width:w|0,height:h|0}}}))
        console.log("[resolution] demande "+w+"x"+h);
      var c=active(); if(c) c.focus();
    }
    window.__rdMenu=function(){
      var r=RD.res||[]; sel.innerHTML="";
      var o=document.createElement("option");
      o.textContent=r.length?"Resolution":"(indisponible)"; o.value="";
      sel.appendChild(o);
      r.forEach(function(m){ var x=document.createElement("option");
        x.value=m.width+"x"+m.height; x.textContent=m.width+"x"+m.height; sel.appendChild(x); });
    };
    sel.onchange=function(){ if(!sel.value) return; var v=sel.value.split("x"); apply(+v[0],+v[1]); };
    fit.onclick=function(){
      var r=RD.res||[]; if(!r.length){ console.warn("[resolution] aucune liste"); return; }
      var vw=window.innerWidth, vh=window.innerHeight, best=null, score=Infinity;
      r.forEach(function(m){
        var d=Math.abs(m.width-vw)+Math.abs(m.height-vh);
        if(Math.abs(m.width/m.height - vw/vh)<0.02) d*=0.5;
        if(d<score){ score=d; best=m; }
      });
      if(best) apply(best.width,best.height);
    };
    window.__rdBar=bar;
    window.__rdMenu();

    // --- Affichage des percentiles ---
    var hud=document.createElement("div"); hud.id="rdhud";
    document.body.appendChild(hud);
    window.__rdHud=hud;
    var lastFrames=0, lastT=performance.now();

    setInterval(function(){
      var S=RD.stats, P=window.__rdPct;
      var now=performance.now(), dt=(now-lastT)/1000;
      var ips = dt>0 ? (S.frames-lastFrames)/dt : 0;
      lastFrames=S.frames; lastT=now;

      function fmt(a,u){
        if(!a.length) return "—";
        return P(a,.50).toFixed(0)+" / "+P(a,.95).toFixed(0)+" / "+P(a,.99).toFixed(0)+" "+u;
      }
      hud.textContent =
        "aller-retour  p50/p95/p99   " + fmt(S.delay,"ms") + "\n" +
        "decodage      p50/p95/p99   " + fmt(S.decode,"ms") + "\n" +
        "trames recues " + ips.toFixed(1) + "/s    debit cible " + S.bitrate + " kbit/s" +
        "    codec " + (RD.codec || "logiciel") +
        (hud.dataset.reprise ? "\n" + hud.dataset.reprise : "");
    }, 1000);

    window.addEventListener("resize", fitCanvas);

    // Veilleur : taille, reglages initiaux, repatch apres reconnexion.
    var last=0, tuned=false;
    setInterval(function(){
      var c = active();
      if (c && c.width !== last){
        last = c.width;
        console.log("[ecran distant] "+c.width+"x"+c.height);
        fitCanvas();
      }
      // Qualite rehaussee une fois la session prete : la contrainte n'est pas
      // la bande passante (le relais plafonne 30x au-dessus du besoin).
      if (RD.ready && !tuned){
        tuned = rdSend({misc:{option:{custom_image_quality:150}}});
        if (tuned) console.log("[qualite] ratio 1.5 applique");
      }
      // Memoriser le mot de passe du pair : ui.js ne l'active jamais.
      try{ if(window.curConn && !window.curConn.getRemember()) window.curConn.setRemember(true); }catch(_){}
      // Reappliquer les substitutions : curConn est remplace a chaque
      // connexion, et reconnect() reutilise l'instance avec un _ws neuf.
      try{ patchConn(window.curConn); }catch(_){}
      // Le canvas GARDE sa largeur apres une coupure : c.width reste a 1920 et
      // la fin de session passait inapercue. On interroge donc l'etat reel :
      // le conteneur d'affichage est-il visible, et la liaison est-elle ouverte.
      var enSession = (function(){
        var d = document.getElementById("canvas");
        if (!d || getComputedStyle(d).display === "none") return false;
        var k = window.curConn;
        if (!k || !k._ws || !k._ws._websocket) return false;
        return k._ws._websocket.readyState === 1;
      })();
      if (enSession) veilleActiver(); else veilleLiberer();
      // Transition « en session » -> « plus en session » : tenter une reprise.
      if (window.__rdEtait && !enSession) repriseplanifier();
      if (enSession){ repriseAnnuler(); repriseInfo(""); }
      window.__rdEtait = enSession;
      var vu = enSession ? "block" : "none";
      if (window.__rdBar) window.__rdBar.style.display = (vu==="block") ? "flex" : "none";
      if (window.__rdHud) window.__rdHud.style.display = vu;
    }, 800);
  }

  // ------------------------------------------------- preremplissage du formulaire
  // ui.js remplit les champs dans document.body.onload, qui peut ne jamais se
  // declencher (module differe). Et le gestionnaire de mots de passe du
  // navigateur ecrase le champ ID en le prenant pour un identifiant de compte
  // — il propose souvent l'identifiant du compte a la place de l'ID.
  // Valeurs faisant autorite : elles viennent du deploiement, jamais du formulaire.
  var RD_HOST = "__RD_DOMAIN__", RD_KEY = "__RD_PUBLIC_KEY__";
  var DEFAUT_ID = "__RD_DEFAULT_PEER_ID__";
  function prefillForm(){
    var host=document.getElementById("host"),
        id  =document.getElementById("id"),
        key =document.getElementById("key");
    if(!host||!id||!key) return false;
    if(host.dataset.prefilled) return true;
    host.dataset.prefilled="1";

    [host,id,key].forEach(function(el){
      el.setAttribute("autocomplete","off");
      el.setAttribute("autocorrect","off");
      el.setAttribute("spellcheck","false");
      el.setAttribute("data-1p-ignore","");      // 1Password
      el.setAttribute("data-lpignore","true");   // LastPass
    });
    id.setAttribute("inputmode","numeric");
    id.setAttribute("name","rd-target-id");      // nom neutre : pas "user"/"login"

    host.value = localStorage.getItem("custom-rendezvous-server") || "";
    key.value  = localStorage.getItem("key") || "";
    // L'ID reste modifiable : on ne le pose que s'il est vide ou si le
    // gestionnaire de mots de passe l'a rempli avec autre chose qu'un ID.
    var v = (id.value||"").trim();
    if(!v || !/^[0-9 ]{6,}$/.test(v)) id.value = localStorage.getItem("id") || DEFAUT_ID;

    // Corrige aussi un remplissage tardif par le navigateur.
    setTimeout(function(){
      var w=(id.value||"").trim();
      if(!w || !/^[0-9 ]{6,}$/.test(w)) id.value = localStorage.getItem("id") || DEFAUT_ID;
      if(key.value !== RD_KEY) key.value = RD_KEY;
      if(host.value !== RD_HOST) host.value = RD_HOST;
    }, 400);

    console.log("[formulaire] prerempli — ID "+id.value+" (modifiable)");
    return true;
  }

  // Le bundle recopie le formulaire dans localStorage a CHAQUE connexion :
  //   window.connect = () => { … localStorage.setItem("key", $("#key").value) … }
  // Tout ce qui a rempli #key entre-temps devient donc la cle envoyee a hbbr.
  // Le gestionnaire de mots de passe du navigateur le fait volontiers : il voit
  // un trio hote / cle / identifiant et propose ses propres identifiants — on
  // l'avait deja vu s'emparer du champ ID. hbbr rejette alors la liaison relais
  // sans un mot au client (« invalid key » cote serveur, fermeture en moins
  // d'une seconde cote navigateur), et rien a l'ecran n'indique que c'est le
  // formulaire qui a ete altere.
  //
  // L'hote et la cle viennent du deploiement, jamais de l'utilisateur. On les
  // reaffirme donc juste avant que le bundle ne les lise. Seul l'ID reste libre.
  (function protegerConnect(){
    var mien = null;
    setInterval(function(){
      var orig = window.connect;
      if (typeof orig !== "function" || orig === mien) return;  // deja protege
      mien = function(){
        var h = document.getElementById("host"), k = document.getElementById("key");
        if (h && h.value !== RD_HOST){
          console.warn("[formulaire] hote altere (\"" + h.value + "\") — corrige avant connexion");
          h.value = RD_HOST;
        }
        if (k && k.value !== RD_KEY){
          console.warn("[formulaire] cle alteree (" + (k.value ? k.value.length + " caracteres" : "champ vide")
                     + ") — corrigee avant connexion ; sans cela hbbr aurait repondu « invalid key »");
          k.value = RD_KEY;
        }
        return orig.apply(this, arguments);
      };
      window.connect = mien;
      console.log("[formulaire] connexion protegee : hote et cle reaffirmes a chaque essai");
    }, 300);
  })();

  // ---------------------------------------------------------- amorcage
  probeCodecs().then(function(c){
    RD.codec = c;
    console.log("[codec] niveau retenu : " + (c ? c + " (WebCodecs)" : "logiciel (ogv.js)"));
  });

  setInterval(function(){
    prefillForm();
    var p = player();
    if (!p) return;
    wireGlobal();
    wireCanvas(p);
    var r = document.getElementById("rdcanvas");
    if (RD.codec && !r) { r = rdcanvas(); }
    if (r) wireCanvas(r);
    showActive();
  }, 400);
})();
</script>

<script>
// ===================================================================
// Transfert de fichiers.
//
// Pourquoi une SECONDE connexion : sur le pair, `file_action` n'est traite que
// si `self.file_transfer.is_some()` (connection.rs), champ pose uniquement par
// `LoginRequest.file_transfer`. En session distante ordinaire, toute FileAction
// est ignoree EN SILENCE — ni erreur, ni accuse. Il faut donc une session
// dediee, qui n'ouvre aucun flux video.
//
// Pourquoi pas le presse-papier : un navigateur ne peut ecrire dans le
// presse-papier du systeme que text/plain, text/html et image/png. Il n'existe
// aucun chemin vers CF_HDROP (Windows) ni NSFilenamesPboardType (macOS). Coller
// un fichier du Mac dans le Finder local est hors d'atteinte du web —
// definitivement, pas temporairement. C'est aussi la conclusion de Teleport,
// Guacamole et Kasm, qui ouvrent tous un canal lateral plutot que d'essayer.
// ===================================================================
(function(){
  var BLOC = 128 * 1024;          // meme taille que le pair (fs.rs, BUF_SIZE)
  var HAUT = 4 * 1024 * 1024;     // contre-pression : on suspend au-dessus
  var T_FICHIER = 4;              // FileType.File (Dir=0, DirLink=2, DirDrive=3)

  var FT = {
    conn: null,
    etat: "ferme",                // ferme | ouverture | prete | erreur
    err: "",
    cwd: "",
    entries: [],
    jobs: {},
    prochainId: 1,
    attente: []
  };
  window.RDFT = FT;

  // ---------------------------------------------------------- utilitaires
  function taille(n){
    if (!(n > 0)) return "0 o";
    var u = ["o","Ko","Mo","Go","To"], i = Math.floor(Math.log(n)/Math.log(1024));
    if (i > 4) i = 4;
    return (n/Math.pow(1024,i)).toFixed(i ? 1 : 0) + " " + u[i];
  }
  function date(s){
    if (!s) return "";
    try { return new Date(s*1000).toLocaleDateString("fr-CH",
            {day:"2-digit",month:"2-digit",year:"2-digit"}); }
    catch(_){ return ""; }
  }
  // Le pair est un Mac : separateur "/".
  function joindre(a, b){
    if (!a) return b; if (!b) return a;
    return a.replace(/\/+$/,"") + "/" + b.replace(/^\/+/,"");
  }
  function parent(p){
    if (!p || p === "/") return p || "";
    var i = p.replace(/\/+$/,"").lastIndexOf("/");
    return i <= 0 ? "/" : p.slice(0, i);
  }
  function base(p){ return (p || "").replace(/\/+$/,"").split("/").pop() || p; }
  function dormir(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

  function envoyer(msg){
    var c = FT.conn;
    if (!c || !c._ws || !c._ws._websocket) return false;
    if (c._ws._websocket.readyState !== 1) return false;
    try { c._ws.sendMessage(msg); return true; }
    catch(e){ console.warn("[fichiers] envoi", e); return false; }
  }
  function tampon(){
    try { return FT.conn._ws._websocket.bufferedAmount; } catch(_){ return 0; }
  }

  // ------------------------------------------------------- sonde entrante
  // parseMessage est une methode de PROTOTYPE de la classe websock : on
  // l'enveloppe une seule fois, donc avant meme que la connexion fichier
  // n'existe. Aucune course, aucune table d'instances a tenir — file_response
  // n'arrive jamais sur la session video.
  var sondePosee = false;
  function poserSonde(){
    if (sondePosee) return true;
    var k = window.curConn;
    if (!k || !k._ws || !k._ws.constructor) return false;
    var WS = k._ws.constructor;
    if (!WS.prototype.__rdSonde){
      var orig = WS.prototype.parseMessage;
      WS.prototype.parseMessage = function(b){
        var m = orig.call(this, b);
        try { if (m && m.file_response) onReponse(m.file_response); }
        catch(e){ console.warn("[fichiers] reponse", e); }
        return m;
      };
      WS.prototype.__rdSonde = true;
      console.log("[fichiers] sonde de messages posee");
    }
    sondePosee = true;
    return true;
  }

  // ------------------------------------------------- ouverture de session
  function resoudre(ok, err){
    var l = FT.attente; FT.attente = [];
    l.forEach(function(p){ if (ok) p.res(FT.conn); else p.rej(new Error(err)); });
  }
  function echec(msg){
    FT.etat = "erreur"; FT.err = msg;
    console.warn("[fichiers] " + msg);
    majEtat(); resoudre(false, msg);
  }

  function ouvrir(){
    return new Promise(function(res, rej){
      if (FT.etat === "prete" && FT.conn) { res(FT.conn); return; }
      FT.attente.push({res:res, rej:rej});
      if (FT.etat === "ouverture") return;

      if (!poserSonde()){ echec("session video absente"); return; }
      var k = window.curConn, id = k && k._id;
      if (!id){ echec("aucune session en cours"); return; }

      FT.etat = "ouverture"; FT.err = ""; majEtat();
      var c;
      try { c = new (k.constructor)(); }
      catch(e){ echec("instanciation impossible : " + e); return; }
      FT.conn = c;

      // --- Les quatre neutralisations, POSEES AVANT start() ---

      // 1. Le seul changement fonctionnel : declarer file_transfer dans le
      //    LoginRequest. `option` est volontairement omis — le pair ecarte
      //    hors perimetre toute option de login sur une session fichier
      //    (scoped_login_option), et nous n'en avons besoin d'aucune.
      c._sendLoginMessage = function(pwd){
        if (!this._ws) return;
        this._ws.sendMessage({ login_request: {
          username: this._id, my_id: "web", my_name: "web",
          password: pwd, video_ack_required: false,
          file_transfer: { dir: "", show_hidden: false }
        }});
      };

      // 2. L'original fait `if (displays.length == 0) msgbox("No Display")` :
      //    une session fichier n'a JAMAIS de display. Il faut donc le
      //    remplacer, pas l'envelopper — sinon la session s'annonce en erreur
      //    au moment meme ou elle reussit.
      c.handlePeerInfo = function(){
        FT.etat = "prete"; FT.err = "";
        console.log("[fichiers] session ouverte");
        majEtat(); resoudre(true);
      };

      // 3. Les messages de cette session ne doivent pas ecraser l'interface de
      //    la session video. setMsgbox est l'API publique du bundle pour cela.
      c.setMsgbox(function(type, titre, texte){
        if (type === "error"){ var m = texte || titre || "erreur"; fermer(); echec(m); }
      });

      // 4. Aucun flux video ici : ne pas charger ogv.js ni son wasm.
      c.loadVideoDecoder = function(){};

      c.start(id);   // ne se resout jamais : _start attend msgLoop
      setTimeout(function(){
        if (FT.etat === "ouverture") echec("delai depasse a l'ouverture");
      }, 20000);
    });
  }

  function fermer(){
    var c = FT.conn; FT.conn = null;
    if (FT.etat !== "erreur") { FT.etat = "ferme"; FT.err = ""; }
    Object.keys(FT.jobs).forEach(function(k){ FT.jobs[k].annule = true; });
    if (c) { try { c.close(); } catch(_){} }
    majEtat();
  }
  FT.fermer = fermer;

  // ------------------------------------------------------------- travaux
  function nouveauJob(type, libelle){
    var j = { id: FT.prochainId++, type: type, libelle: libelle,
              fait: 0, total: 0, etat: "en cours", err: "",
              annule: false, chaine: Promise.resolve(), t0: Date.now(),
              apres: null, puits: null, numCourant: -1 };
    FT.jobs[j.id] = j; majFile();
    return j;
  }
  function finirJob(j, err){
    if (j.etat !== "en cours") return;
    j.etat = err ? "echec" : "fini"; j.err = err || "";
    if (err) console.warn("[fichiers] " + (j.libelle || j.type) + " : " + err);
    // Une etape interne qui echoue n'a pas de ligne a elle : sans cela, la
    // suppression d'un dossier resterait partielle en silence.
    if (err && j.discret){ FT.err = err; majEtat(); }
    majFile();
    if (!err && j.apres) { var f = j.apres; j.apres = null; try { f(); } catch(e){ console.warn(e); } }
    // Les reussites s'effacent d'elles-memes ; les echecs restent affiches,
    // sinon on ne saurait pas ce qui a rate.
    if (!err) setTimeout(function(){ delete FT.jobs[j.id]; majFile(); }, 4000);
  }

  // -------------------------------------------------------- navigation
  function lister(chemin){
    return ouvrir().then(function(){
      envoyer({ file_action: { read_dir: { path: chemin || "", include_hidden: false } } });
    });
  }
  FT.lister = lister;

  // --------------------------------------------------------- reception
  function onReponse(fr){
    if (fr.dir)   return onDir(fr.dir);
    if (fr.block) return onBloc(fr.block);
    if (fr.done)  return onFini(fr.done);
    if (fr.error) return onErreur(fr.error);
  }

  function onDir(d){
    var j = FT.jobs[d.id];
    // Une reponse read_dir n'a pas d'identifiant propre — le message ReadDir
    // n'a pas de champ id. Tout ce qui ne correspond pas a un travail en
    // attente de liste est donc un listing de navigation.
    if (j && j.attendListe){
      j.attendListe = false;
      var fichiers = (d.entries || []).slice();
      // Un chemin de FICHIER produit une entree unique au nom VIDE : le pair
      // en derive le nom depuis le chemin (fs.rs, read_dir_recursive, branche
      // is_file). On fait pareil, sinon le fichier serait ecrit sans nom.
      if (fichiers.length === 1 && !fichiers[0].name) fichiers[0].name = base(j.chemin);
      j.fichiers = fichiers;
      j.total = fichiers.reduce(function(a,f){ return a + (f.size||0); }, 0);
      majFile();
      if (j.suiteListe) j.suiteListe();
      return;
    }
    FT.cwd = d.path || FT.cwd;
    FT.entries = (d.entries || []).slice();
    rendreListe();
  }

  function onErreur(e){
    var j = FT.jobs[e.id];
    if (j) finirJob(j, e.error || "erreur");
    else { FT.err = e.error || "erreur"; majEtat(); }
  }

  function onFini(d){
    var j = FT.jobs[d.id];
    if (!j) return;
    // Enchaine derriere les blocs encore en traitement : `done` arrive apres
    // le dernier bloc sur le fil, mais notre traitement, lui, est asynchrone.
    j.chaine = j.chaine.then(function(){
      return j.puits ? Promise.resolve(j.puits.fermer()).catch(function(){}) : null;
    }).then(function(){
      j.puits = null;
      finirJob(j, j.annule ? "annule" : null);
    });
  }

  // ----------------------------------------------------- telechargement
  function onBloc(b){
    var j = FT.jobs[b.id];
    if (!j || j.type !== "dl" || j.annule) return;
    // Serialisation stricte : la decompression et l'ecriture sont asynchrones
    // et les blocs arrivent en rafale. Sans cette chaine, l'ordre des octets
    // ecrits dependrait de l'ordonnancement des promesses.
    j.chaine = j.chaine.then(function(){ return traiterBloc(j, b); })
                       .catch(function(e){ finirJob(j, String(e && e.message || e)); });
  }

  function traiterBloc(j, b){
    if (j.annule) return null;
    var num = b.file_num | 0;
    var p = Promise.resolve();
    if (j.numCourant !== num){
      if (j.puits) p = Promise.resolve(j.puits.fermer()).catch(function(){});
      p = p.then(function(){
        j.numCourant = num;
        var f = j.fichiers[num];
        if (!f) throw new Error("bloc hors liste (file_num " + num + ")");
        return ouvrirPuits(j, f.name);
      }).then(function(puits){ j.puits = puits; });
    }
    return p.then(function(){
      if (!b.compressed) return b.data;
      if (!window.__rdUnzstd) throw new Error("decodeur zstd absent du bundle");
      return window.__rdUnzstd(b.data).then(function(d){
        if (!d) throw new Error("decompression zstd echouee");
        return d;
      });
    }).then(function(data){
      if (j.annule || !j.puits) return null;
      j.fait += data.length; majFile();
      return j.puits.ecrire(data);
    });
  }

  // cible : {dossier: FileSystemDirectoryHandle} | {handle: FileSystemFileHandle} | null
  function telecharger(entree, cible){
    var chemin = joindre(FT.cwd, entree.name);
    return ouvrir().then(function(){
      var j = nouveauJob("dl", "↓ " + entree.name);
      j.chemin = chemin;
      j.attendListe = true;
      j.dossierCible = (cible && cible.dossier) || null;
      j.handleUnique = (cible && cible.handle) || null;
      // Deux temps imposes par le protocole : all_files donne les noms dans
      // l'ORDRE EXACT ou les blocs arriveront (les deux passent par
      // get_recursive_files). C'est l'unique moyen de nommer un file_num.
      j.suiteListe = function(){
        if (!j.fichiers.length){ finirJob(j, "rien a transferer"); return; }
        envoyer({ file_action: { send: {
          id: j.id, path: chemin, file_num: 0, include_hidden: false } } });
      };
      envoyer({ file_action: { all_files: {
        id: j.id, path: chemin, include_hidden: false } } });
    });
  }
  FT.telecharger = telecharger;

  // ------------------------------------------------------------ puits
  function ouvrirPuits(j, nom){
    // 1. Chromium : ecriture directe sur le disque, bloc par bloc. Rien n'est
    //    accumule, un fichier de plusieurs Go passe sans occuper de memoire.
    if (j.dossierCible){
      return creerDansDossier(j.dossierCible, nom).then(function(fh){
        return fh.createWritable();
      }).then(enrober);
    }
    if (j.handleUnique){
      var h = j.handleUnique; j.handleUnique = null;
      return h.createWritable().then(enrober);
    }
    // 2. Partout ailleurs : accumulation en Blob. Contrairement a un tableau
    //    d'octets, un Blob n'est PAS tenu de rester en memoire — le navigateur
    //    le deverse sur disque. L'OPFS a ete ecarte : il faudrait de toute
    //    facon en ressortir un Blob pour declencher le telechargement, donc il
    //    ajouterait une copie complete sans rien resoudre.
    var parts = [];
    return Promise.resolve({
      ecrire: function(d){ parts.push(new Blob([d])); },
      fermer: function(){
        var blob = new Blob(parts, {type:"application/octet-stream"});
        parts = null;
        offrir(blob, base(nom));
      }
    });
  }
  function enrober(w){
    return { ecrire: function(d){ return w.write(d); },
             fermer: function(){ return w.close(); } };
  }

  function creerDansDossier(racine, nomRelatif){
    var bouts = nomRelatif.split("/").filter(Boolean);
    var fichier = bouts.pop();
    var p = Promise.resolve(racine);
    bouts.forEach(function(d){
      p = p.then(function(h){ return h.getDirectoryHandle(d, {create:true}); });
    });
    return p.then(function(h){ return h.getFileHandle(fichier, {create:true}); });
  }

  var offerts = [];
  function offrir(blob, nom){
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url; a.download = nom; a.style.display = "none";
    document.body.appendChild(a); a.click();
    setTimeout(function(){ a.remove(); }, 0);
    // L'URL reste vivante : elle sert au glisser-vers-le-bureau, et la
    // revoquer trop tot casserait un telechargement encore en cours.
    offerts.push({url:url, nom:nom, blob:blob});
    while (offerts.length > 12){ URL.revokeObjectURL(offerts.shift().url); }
    majFile();
  }

  // ------------------------------------------------------- televersement
  function televerser(fichiers, destination){
    if (!fichiers.length) return Promise.resolve();
    return ouvrir().then(function(){
      var total = fichiers.reduce(function(a,f){ return a + f.file.size; }, 0);
      var lib = fichiers.length === 1 ? "↑ " + (fichiers[0].chemin || fichiers[0].file.name)
                                      : "↑ " + fichiers.length + " fichiers";
      var j = nouveauJob("ul", lib);
      j.total = total;
      // Le pair attend la liste AVANT les blocs : elle fixe l'ordre, et donc
      // la signification de chaque file_num.
      envoyer({ file_action: { receive: {
        id: j.id, path: destination, file_num: 0, total_size: total,
        files: fichiers.map(function(f){
          return { entry_type: T_FICHIER,
                   name: f.chemin || f.file.name,
                   is_hidden: false,
                   size: f.file.size,
                   modified_time: Math.floor((f.file.lastModified || Date.now())/1000) };
        }) } } });
      return pousser(j, fichiers);
    });
  }
  FT.televerser = televerser;

  function pousser(j, fichiers){
    var i = 0;
    function fichierSuivant(){
      if (j.annule) return Promise.resolve();
      if (i >= fichiers.length){
        envoyer({ file_response: { done: { id: j.id, file_num: fichiers.length } } });
        finirJob(j, null);
        return Promise.resolve();
      }
      var num = i, f = fichiers[i++].file, pos = 0, blk = 0;
      function trancheSuivante(){
        if (j.annule) return Promise.resolve();
        if (pos >= f.size) return fichierSuivant();
        // Contre-pression : sans elle le tampon du socket enfle sans limite et
        // la session VIDEO devient saccadee — les deux connexions partagent la
        // meme liaison relais.
        if (tampon() > HAUT) return dormir(20).then(trancheSuivante);
        var fin = Math.min(pos + BLOC, f.size);
        return f.slice(pos, fin).arrayBuffer().then(function(buf){
          if (j.annule) return null;
          var d = new Uint8Array(buf);
          // compressed:false — le pair ne decompresse que sur ce drapeau, et
          // compresser ici couterait du temps processeur pour rien.
          if (!envoyer({ file_response: { block: {
                id: j.id, file_num: num, data: d, compressed: false, blk_id: blk++ } } })){
            throw new Error("liaison fermee");
          }
          pos = fin; j.fait += d.length; majFile();
          return trancheSuivante();
        });
      }
      return trancheSuivante();
    }
    return fichierSuivant().catch(function(e){ finirJob(j, String(e && e.message || e)); });
  }

  // ------------------------------------------------- lecture d'un depot
  // webkitGetAsEntry est supporte partout et sait descendre une arborescence
  // deposee. C'est le seul moyen d'accepter un DOSSIER par glisser-deposer.
  function lireEntree(entry, prefixe){
    return new Promise(function(res){
      if (entry.isFile){
        entry.file(function(f){ res([{ file:f, chemin: joindre(prefixe, entry.name) }]); },
                   function(){ res([]); });
      } else if (entry.isDirectory){
        var lect = entry.createReader(), tout = [];
        (function lot(){
          lect.readEntries(function(es){
            if (!es.length){
              Promise.all(tout.map(function(e){
                return lireEntree(e, joindre(prefixe, entry.name));
              })).then(function(rs){ res([].concat.apply([], rs)); });
              return;
            }
            tout = tout.concat(Array.prototype.slice.call(es));
            lot();
          }, function(){ res([]); });
        })();
      } else res([]);
    });
  }

  function depuisTransfert(dt){
    var items = dt && dt.items;
    if (items && items.length && items[0].webkitGetAsEntry){
      var es = [];
      for (var i=0;i<items.length;i++){
        if (items[i].kind !== "file") continue;
        var e = items[i].webkitGetAsEntry();
        if (e) es.push(e);
      }
      if (es.length){
        return Promise.all(es.map(function(e){ return lireEntree(e, ""); }))
                      .then(function(rs){ return [].concat.apply([], rs); });
      }
    }
    var fs = dt && dt.files ? Array.prototype.slice.call(dt.files) : [];
    return Promise.resolve(fs.map(function(f){ return { file:f, chemin:f.name }; }));
  }
  FT.depuisTransfert = depuisTransfert;

  function aDesFichiers(dt){
    if (!dt || !dt.types) return false;
    for (var i=0;i<dt.types.length;i++) if (dt.types[i] === "Files") return true;
    return false;
  }

  // =================================================================
  // Interface
  // =================================================================
  var pan, ul, filAr, etatEl, filesEl, btnHaut, btnMaj, btnUp, btnDir, inF, inD;

  function construire(){
    if (pan) return pan;
    pan = document.createElement("div"); pan.id = "rdfiles";

    var head = document.createElement("header");
    var titre = document.createElement("b"); titre.textContent = "Fichiers distants";
    etatEl = document.createElement("span"); etatEl.className = "etat";
    var x = document.createElement("button"); x.textContent = "✕";
    x.title = "Fermer le panneau"; x.onclick = function(){ basculer(false); };
    head.appendChild(titre); head.appendChild(etatEl); head.appendChild(x);

    var nav = document.createElement("nav");
    btnHaut = document.createElement("button"); btnHaut.textContent = "⟵";
    btnHaut.title = "Dossier parent";
    btnHaut.onclick = function(){ lister(parent(FT.cwd)); rendreMain(); };
    btnMaj = document.createElement("button"); btnMaj.textContent = "⟳";
    btnMaj.title = "Rafraichir";
    btnMaj.onclick = function(){ lister(FT.cwd); rendreMain(); };
    btnUp = document.createElement("button"); btnUp.textContent = "Televerser";
    btnUp.title = "Envoyer des fichiers ou un dossier vers ce repertoire";
    btnDir = document.createElement("button"); btnDir.textContent = "+ Dossier";
    btnDir.onclick = function(){ demanderDossier(); };
    filAr = document.createElement("span"); filAr.className = "fil";
    [btnHaut, btnMaj, btnUp, btnDir, filAr].forEach(function(e){ nav.appendChild(e); });

    // Deux champs : webkitdirectory est exclusif, un navigateur ne peut pas
    // proposer "fichiers OU dossier" dans le meme selecteur.
    inF = document.createElement("input");
    inF.type = "file"; inF.multiple = true; inF.style.display = "none";
    inD = document.createElement("input");
    inD.type = "file"; inD.webkitdirectory = true; inD.style.display = "none";
    inF.onchange = function(){ depuisInput(inF); };
    inD.onchange = function(){ depuisInput(inD); };
    btnUp.onclick = function(){ choisirSource(); };

    ul = document.createElement("ul");
    filesEl = document.createElement("div"); filesEl.className = "files";
    var depot = document.createElement("div"); depot.className = "depot";
    depot.textContent = "Deposer ici pour televerser dans ce dossier";

    pan.appendChild(inF); pan.appendChild(inD);
    pan.appendChild(head); pan.appendChild(nav); pan.appendChild(ul);
    pan.appendChild(filesEl); pan.appendChild(depot);
    document.body.appendChild(pan);
    cablerDepot(pan);
    return pan;
  }

  function choisirSource(){
    modale({
      titre: "Que televerser ?",
      corps: "Le selecteur du navigateur ne peut pas proposer les deux a la fois.",
      okTexte: "Des fichiers", autreTexte: "Un dossier",
      onOk:    function(){ inF.value = ""; inF.click(); },
      onAutre: function(){ inD.value = ""; inD.click(); }
    });
  }

  function depuisInput(inp){
    var fs = Array.prototype.slice.call(inp.files || []);
    if (!fs.length) return;
    var liste = fs.map(function(f){
      return { file:f, chemin: f.webkitRelativePath || f.name };
    });
    var dest = FT.cwd;
    televerser(liste, dest).then(function(){ lister(dest); });
  }

  function cablerDepot(cible){
    var n = 0;
    cible.addEventListener("dragover", function(ev){
      if (!aDesFichiers(ev.dataTransfer)) return;
      ev.preventDefault(); ev.dataTransfer.dropEffect = "copy";
    });
    cible.addEventListener("dragenter", function(ev){
      if (!aDesFichiers(ev.dataTransfer)) return;
      ev.preventDefault(); n++; pan.classList.add("survol");
    });
    cible.addEventListener("dragleave", function(){
      if (--n <= 0){ n = 0; pan.classList.remove("survol"); }
    });
    cible.addEventListener("drop", function(ev){
      if (!aDesFichiers(ev.dataTransfer)) return;
      ev.preventDefault(); n = 0; pan.classList.remove("survol");
      accepterDepot(ev.dataTransfer);
    });
  }

  function accepterDepot(dt){
    var dest = FT.cwd;
    return depuisTransfert(dt).then(function(liste){
      if (!liste.length) return null;
      basculer(true);
      return televerser(liste, dest).then(function(){ lister(dest); });
    });
  }
  FT.accepterDepot = accepterDepot;

  // ------------------------------------------------------------- rendus
  function majEtat(){
    if (!etatEl) return;
    var m = { ferme:"deconnecte", ouverture:"connexion…", prete:"connecte", erreur:FT.err };
    etatEl.textContent = m[FT.etat] || FT.etat;
    etatEl.className = "etat" + (FT.etat === "erreur" ? " err" : "");
    var off = FT.etat !== "prete";
    [btnHaut, btnMaj, btnUp, btnDir].forEach(function(b){ if (b) b.disabled = off; });
  }

  function rendreMain(){ var c = window.__rdActive && window.__rdActive(); if (c) c.focus(); }

  function estDossier(e){ var t = e.entry_type|0; return t === 0 || t === 2 || t === 3; }

  function rendreListe(){
    if (!ul) return;
    filAr.innerHTML = "";
    var r = document.createElement("a"); r.textContent = "/";
    r.onclick = function(){ lister("/"); };
    filAr.appendChild(r);
    var acc = "";
    (FT.cwd || "").split("/").filter(Boolean).forEach(function(b){
      acc = acc + "/" + b;
      var chemin = acc;
      filAr.appendChild(document.createTextNode(" "));
      var a = document.createElement("a"); a.textContent = b;
      a.onclick = function(){ lister(chemin); };
      filAr.appendChild(a);
      filAr.appendChild(document.createTextNode(" /"));
    });

    ul.innerHTML = "";
    var es = FT.entries.slice().sort(function(a,b){
      var da = estDossier(a), db = estDossier(b);
      if (da !== db) return da ? -1 : 1;
      return (a.name||"").localeCompare(b.name||"", "fr");
    });
    if (!es.length){
      var v = document.createElement("li"); v.className = "vide";
      v.textContent = FT.etat === "prete" ? "Dossier vide" : "…";
      ul.appendChild(v); return;
    }
    es.forEach(function(e){ ul.appendChild(ligne(e)); });
  }

  function ligne(e){
    var li = document.createElement("li");
    var dossier = estDossier(e);
    var nom = document.createElement("span"); nom.className = "nom";
    nom.textContent = (dossier ? "📁 " : "📄 ") + e.name;
    nom.title = dossier ? "Ouvrir" : "Telecharger";
    nom.onclick = function(){
      if (dossier) lister(joindre(FT.cwd, e.name)); else lancerTelechargement(e, dossier);
      rendreMain();
    };
    var meta = document.createElement("span"); meta.className = "meta";
    meta.textContent = (dossier ? "" : taille(e.size||0) + "  ") + date(e.modified_time);

    var actes = document.createElement("span"); actes.className = "actes";
    var dl = document.createElement("button"); dl.textContent = "↓";
    dl.title = dossier ? "Telecharger le dossier" : "Telecharger";
    dl.onclick = function(){ lancerTelechargement(e, dossier); rendreMain(); };
    var ren = document.createElement("button"); ren.textContent = "✏️";
    ren.title = "Renommer"; ren.onclick = function(){ demanderRenommage(e); };
    var sup = document.createElement("button"); sup.textContent = "🗑";
    sup.title = "Supprimer"; sup.onclick = function(){ demanderSuppression(e, dossier); };
    [dl, ren, sup].forEach(function(b){ actes.appendChild(b); });

    li.appendChild(nom); li.appendChild(meta); li.appendChild(actes);
    return li;
  }

  // Le selecteur de destination exige un geste utilisateur : il doit surgir
  // MAINTENANT, pas a l'arrivee du premier bloc.
  function lancerTelechargement(e, dossier){
    if (dossier && window.showDirectoryPicker){
      return window.showDirectoryPicker({ mode:"readwrite" })
        .then(function(h){ return telecharger(e, {dossier:h}); })
        .catch(function(){});
    }
    if (!dossier && window.showSaveFilePicker){
      return window.showSaveFilePicker({ suggestedName: e.name })
        .then(function(h){ return telecharger(e, {handle:h}); })
        .catch(function(){});
    }
    return telecharger(e, null);
  }

  function majFile(){
    if (!filesEl) return;
    filesEl.innerHTML = "";
    Object.keys(FT.jobs).forEach(function(k){
      var j = FT.jobs[k];
      if (j.discret) return;                                  // etapes internes
      if (j.type === "op" && j.etat === "en cours") return;   // trop bref pour etre utile
      var d = document.createElement("div");
      d.className = "job" + (j.etat === "echec" ? " ko" : "");
      var t = document.createElement("div"); t.className = "t";
      var n = document.createElement("span"); n.textContent = j.libelle;
      var em = document.createElement("em");
      var dt = (Date.now() - j.t0)/1000;
      em.textContent = j.etat === "echec" ? j.err
                     : j.etat === "fini"  ? "termine"
                     : taille(j.fait) + (j.total ? " / " + taille(j.total) : "")
                       + (dt > 0.4 ? "  " + taille(j.fait/dt) + "/s" : "");
      t.appendChild(n); t.appendChild(em);
      if (j.etat === "en cours"){
        var x = document.createElement("button"); x.textContent = "✕";
        x.title = "Annuler"; x.onclick = function(){ annuler(j); };
        t.appendChild(x);
      }
      d.appendChild(t);
      if (j.etat === "en cours" && j.total){
        var p = document.createElement("progress");
        p.max = j.total; p.value = Math.min(j.fait, j.total);
        d.appendChild(p);
      }
      filesEl.appendChild(d);
    });
    offerts.slice().reverse().forEach(function(o){ filesEl.appendChild(ligneOfferte(o)); });
  }

  function annuler(j){
    j.annule = true;
    envoyer({ file_action: { cancel: { id: j.id } } });
    finirJob(j, "annule");
  }

  // ------------------------------- glisser vers le bureau (Chromium seul)
  // API non documentee, nee pour les pieces jointes de Gmail. C'est le plus
  // pres du "couper-coller vers le Finder" que le web autorise. Detectee par
  // la valeur de retour de setData, qui vaut false hors Chromium.
  function ligneOfferte(o){
    var d = document.createElement("div"); d.className = "job";
    var t = document.createElement("div"); t.className = "t";
    var n = document.createElement("span"); n.textContent = "✓ " + o.nom;
    n.style.cursor = "pointer";
    n.onclick = function(){
      var a = document.createElement("a"); a.href = o.url; a.download = o.nom;
      document.body.appendChild(a); a.click(); a.remove();
    };
    var em = document.createElement("em"); em.textContent = taille(o.blob.size);
    t.appendChild(n); t.appendChild(em); d.appendChild(t);
    d.draggable = true;
    d.title = "Glisser vers le bureau (Chromium), ou cliquer pour retelecharger";
    d.addEventListener("dragstart", function(ev){
      var ok = false;
      try {
        ok = ev.dataTransfer.setData("DownloadURL",
              (o.blob.type || "application/octet-stream") + ":" + o.nom + ":" + o.url) !== false;
      } catch(_){ ok = false; }
      if (!ok) ev.preventDefault();
    });
    return d;
  }

  // ---------------------------------------------------------- modales
  // Pas de confirm()/prompt() natifs : ils bloquent la boucle d'evenements du
  // navigateur, et toute commande ulterieure resterait sans effet.
  var modal;
  function modale(o){
    if (!modal){
      modal = document.createElement("div"); modal.id = "rdmodal";
      document.body.appendChild(modal);
    }
    modal.innerHTML = "";
    var b = document.createElement("div"); b.className = "boite";
    var h = document.createElement("b"); h.textContent = o.titre;
    var p = document.createElement("p"); p.textContent = o.corps || "";
    b.appendChild(h); b.appendChild(p);
    if (o.avert){
      var av = document.createElement("p"); av.className = "avert";
      av.textContent = o.avert; b.appendChild(av);
    }
    var inp = null;
    if (o.champ !== undefined){
      inp = document.createElement("input"); inp.value = o.champ;
      inp.onkeydown = function(ev){ if (ev.key === "Enter") valider(); };
      b.appendChild(inp);
    }
    var btns = document.createElement("div"); btns.className = "btns";
    var no = document.createElement("button"); no.textContent = "Annuler";
    no.onclick = fermerModale; btns.appendChild(no);
    if (o.autreTexte){
      var au = document.createElement("button"); au.textContent = o.autreTexte;
      au.onclick = function(){ fermerModale(); if (o.onAutre) o.onAutre(); };
      btns.appendChild(au);
    }
    var ok = document.createElement("button");
    ok.textContent = o.okTexte || "Confirmer";
    ok.className = "ok" + (o.danger ? " danger" : "");
    ok.onclick = valider; btns.appendChild(ok);
    b.appendChild(btns); modal.appendChild(b); modal.classList.add("ouvert");
    if (inp) setTimeout(function(){ inp.focus(); inp.select(); }, 30);

    function valider(){
      var v = inp ? inp.value : null;
      fermerModale(); if (o.onOk) o.onOk(v);
    }
  }
  function fermerModale(){ if (modal) modal.classList.remove("ouvert"); rendreMain(); }

  function demanderDossier(){
    var dest = FT.cwd;
    modale({ titre:"Nouveau dossier", corps:"Cree dans " + dest, champ:"nouveau dossier",
      onOk: function(nom){
        if (!nom) return;
        var j = nouveauJob("op", "+ " + nom);
        j.apres = function(){ lister(dest); };
        envoyer({ file_action: { create: { id:j.id, path: joindre(dest, nom) } } });
      }});
  }

  function demanderRenommage(e){
    var dest = FT.cwd;
    modale({ titre:"Renommer", corps: joindre(dest, e.name), champ:e.name,
      onOk: function(nom){
        if (!nom || nom === e.name) return;
        // new_name est un nom NU : le pair refuse tout separateur
        // (validate_file_name_no_traversal) et rejoint lui-meme le parent.
        var j = nouveauJob("op", "✏️ " + e.name);
        j.apres = function(){ lister(dest); };
        envoyer({ file_action: { rename: {
          id:j.id, path: joindre(dest, e.name), new_name: nom } } });
      }});
  }

  function demanderSuppression(e, dossier){
    var dest = FT.cwd, chemin = joindre(dest, e.name);
    modale({
      titre: dossier ? "Supprimer le dossier" : "Supprimer le fichier",
      corps: chemin,
      avert: dossier
        ? "Le dossier ET tout son contenu seront effaces sur le Mac. Il n'y a pas de corbeille : c'est irreversible."
        : "Le fichier sera efface sur le Mac. Il n'y a pas de corbeille : c'est irreversible.",
      okTexte:"Supprimer", danger:true,
      onOk: function(){
        if (!dossier){
          var j = nouveauJob("op", "🗑 " + e.name);
          j.apres = function(){ lister(dest); };
          envoyer({ file_action: { remove_file: { id:j.id, path:chemin, file_num:0 } } });
          return;
        }
        // Second palier pour un dossier : le contenu ne revient pas.
        modale({ titre:"Confirmer la suppression",
          corps:"Taper le nom du dossier pour confirmer : " + e.name,
          champ:"", okTexte:"Supprimer definitivement", danger:true,
          onOk: function(saisi){
            if (saisi !== e.name){ FT.err = "nom non confirme"; majEtat(); return; }
            supprimerDossier(chemin, e.name, dest);
          }});
      }});
  }

  // remove_dir{recursive:true} n'efface PAS les fichiers : cote pair il appelle
  // remove_all_empty_dir, qui ne retire que les repertoires vides et les liens
  // (ui_cm_interface.rs). Il faut donc enumerer, effacer chaque fichier, puis
  // demander le retrait de l'arborescence videe. C'est ce que fait le client
  // natif, et l'ignorer laisserait le dossier intact sans le moindre message.
  function supprimerDossier(chemin, nom, dest){
    var j = nouveauJob("rm", "🗑 " + nom);
    j.attendListe = true;
    j.suiteListe = function(){
      var restants = j.fichiers.length;
      j.total = restants || 1;
      if (!restants){ finVidage(); return; }
      var k = 0;
      // Un identifiant par suppression, sinon les reponses seraient
      // indiscernables ; on ne suit que le compte.
      j.fichiers.forEach(function(f){
        var sub = nouveauJob("op", "");
        sub.discret = true;
        sub.apres = function(){ avance(); };
        envoyer({ file_action: { remove_file: {
          id: sub.id, path: joindre(chemin, f.name), file_num: 0 } } });
      });
      function avance(){
        k++; j.fait = k; majFile();
        if (k >= restants) finVidage();
      }
    };
    function finVidage(){
      var fin = nouveauJob("op", "");
      fin.discret = true;
      fin.apres = function(){ finirJob(j, null); lister(dest); };
      envoyer({ file_action: { remove_dir: { id: fin.id, path: chemin, recursive: true } } });
    }
    envoyer({ file_action: { all_files: { id:j.id, path:chemin, include_hidden:true } } });
  }

  // ------------------------------------------------------- bascule / bouton
  function basculer(ouvert){
    construire();
    if (ouvert === undefined) ouvert = !pan.classList.contains("ouvert");
    pan.classList.toggle("ouvert", !!ouvert);
    if (ouvert){
      majEtat(); majFile();
      lister(FT.cwd || "").catch(function(e){ console.warn("[fichiers]", e); });
    } else rendreMain();
  }
  FT.basculer = basculer;

  // Le bouton se greffe sur la barre existante des qu'elle apparait : le bloc
  // precedent n'a ainsi rien a connaitre de ce module.
  var greffe = setInterval(function(){
    var bar = window.__rdBar;
    if (!bar || bar.querySelector(".rdfilesbtn")) return;
    var b = document.createElement("button");
    b.className = "rdfilesbtn"; b.textContent = "Fichiers";
    b.title = "Parcourir, televerser et telecharger sur le Mac distant";
    b.onclick = function(){ basculer(); };
    var q = bar.querySelector("button.quit");
    if (q) bar.insertBefore(b, q); else bar.appendChild(b);
    clearInterval(greffe);
  }, 400);

  // Depot sur le canvas video : meme geste, meme destination.
  document.addEventListener("dragover", function(ev){
    var c = window.__rdActive && window.__rdActive();
    if (!c || ev.target !== c || !aDesFichiers(ev.dataTransfer)) return;
    ev.preventDefault(); ev.dataTransfer.dropEffect = "copy";
  });
  document.addEventListener("drop", function(ev){
    var c = window.__rdActive && window.__rdActive();
    if (!c || ev.target !== c || !aDesFichiers(ev.dataTransfer)) return;
    ev.preventDefault(); accepterDepot(ev.dataTransfer);
  });

  // La session fichier ne survit pas a la session video : on la ferme avec.
  setInterval(function(){
    if (!window.__rdEtait && FT.conn) fermer();
  }, 1500);

  // Diagnostic, en pendant de rdDiag().
  window.rdFiles = function(){
    console.group("Transfert de fichiers");
    console.log("etat      : " + FT.etat + (FT.err ? " (" + FT.err + ")" : ""));
    console.log("dossier   : " + FT.cwd + " — " + FT.entries.length + " entree(s)");
    Object.keys(FT.jobs).forEach(function(k){
      var j = FT.jobs[k];
      console.log("  #" + j.id + " " + (j.libelle || j.type) + " — " + j.etat + " "
                  + taille(j.fait) + " / " + taille(j.total));
    });
    console.log("tampon    : " + taille(tampon()));
    console.log("zstd      : " + (window.__rdUnzstd ? "disponible" : "ABSENT"));
    console.groupEnd();
  };
})();
</script>
<link rel="modulepreload" href="js/dist/vendor.js">
</body>
